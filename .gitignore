# Packaging convention folders (generated by build-zip.sh)
/Deckplate Dist/
/Deckplate Git/
/Deckplate App/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/

# Archives, logs, temp
*.zip
*.7z
*.log
*.tmp

# USB captures. Large binary pcap files, reproduced any time with
# tools/capture-deck.bat, so they are never committed or zipped.
/tools/captures/
*.pcap
*.pcapng

# Secrets: nothing in this tree holds credentials today (weather uses Open
# Meteo, which needs no key). Ignore the usual names so a stray one is never
# committed or zipped.
.env
*credential*
*password*
*secret*
*.pem
*.key
id_rsa*
*FTP*

# Editor and OS noise
.DS_Store
*.swp
Thumbs.db
node_modules/
